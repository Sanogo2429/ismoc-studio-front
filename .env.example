# Modèle de configuration du front-end (copier en .env / .env.production). Aucune valeur secrète ici :
# tout ce qui commence par VITE_ est intégré au JavaScript public du site.

# Adresse HTTPS de l'API .NET en production (obligatoirement https:// → messagerie temps réel en wss://).
VITE_API_BASE_URL=https://api.votre-domaine.fr

# Mode tunnel (npm run tunnel) : l'API est jointe via la même adresse que le site.
# VITE_API_BASE_URL=same-origin
